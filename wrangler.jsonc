{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kexec-run-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
